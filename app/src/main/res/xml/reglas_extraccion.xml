<?xml version="1.0" encoding="utf-8"?>
<!-- Nada sale del celular: ni copia en la nube ni transferencia a otro equipo.
     Para mudarse de celular está el respaldo cifrado de Ajustes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
